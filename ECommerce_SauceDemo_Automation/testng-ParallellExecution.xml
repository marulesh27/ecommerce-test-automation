<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ParallelSuite" parallel="tests" thread-count="4">

    <parameter name="browser" value="chrome"/>

    <test name="LoginTest">
        <classes>
            <class name="ecom.swaglabs.Login.LoginScript"/>
        </classes>
    </test>

    <test name="ProductTest">
        <classes>
            <class name="ecom.swaglabs.Product.ProductCatalogTest"/>
        </classes>
    </test>

    <test name="CheckoutTest">
        <classes>
            <class name="ecom.swaglabs.Checkout.CheckoutScript"/>
        </classes>
    </test>

    <test name="CartTest">
        <classes>
            <class name="ecom.swaglabs.Cart.CartScript"/>
        </classes>
    </test>

</suite>